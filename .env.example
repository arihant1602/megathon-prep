# Copy to .env (scripts/setup.sh does this and fills the secrets).
# Locally every app and service reads this one file. On Railway, set these per service (see deploy/RAILWAY.md).

# --- Data ---
POSTGRES_USER=megathon
POSTGRES_PASSWORD=megathon
POSTGRES_DB=megathon
DATABASE_URL=postgresql://megathon:megathon@localhost:5432/megathon
REDIS_URL=redis://localhost:6379/0

# --- Auth (shared by all four apps: one account works everywhere) ---
BETTER_AUTH_SECRET=change-me
# Each app overrides BETTER_AUTH_URL with its own origin (Makefile / compose / Railway do this).
BETTER_AUTH_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Service mesh ---
INTERNAL_API_KEY=change-me
RISK_SERVICE_URL=http://localhost:8001
LLM_SERVICE_URL=http://localhost:8002
BHASHINI_SERVICE_URL=http://localhost:8003
COLLAB_JWT_SECRET=change-me
COLLAB_PUBLIC_URL=ws://localhost:8004

# --- Providers (fill at the venue) ---
ANTHROPIC_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
